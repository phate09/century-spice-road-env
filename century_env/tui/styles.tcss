Screen {
    layout: grid;
    grid-size: 3 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: auto 1fr 1fr;
}

#status-bar {
    column-span: 3;
    height: 1;
    background: $accent;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

#market-panel {
    row-span: 1;
    border: solid $primary;
    padding: 0 1;
    overflow-y: auto;
}

#scoring-panel {
    row-span: 1;
    border: solid $primary;
    padding: 0 1;
    overflow-y: auto;
}

#players-panel {
    row-span: 1;
    border: solid $primary;
    padding: 0 1;
    overflow-y: auto;
}

#hand-panel {
    column-span: 2;
    border: solid $secondary;
    padding: 0 1;
    overflow-y: auto;
}

#action-panel {
    border: solid $success;
    padding: 0 1;
    overflow-y: auto;
}

#game-log {
    column-span: 3;
    border: solid $surface;
    height: 8;
    min-height: 6;
}

RichLog {
    height: 100%;
}

ClickableItem {
    width: 100%;
    height: auto;
    padding: 0 1;
}

ClickableItem:hover {
    background: $primary 15%;
}

ClickableItem.-disabled {
    opacity: 0.5;
}

ClickableItem.-disabled:hover {
    background: transparent;
}
